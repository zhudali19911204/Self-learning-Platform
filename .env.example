# Copy to .env, select ONE provider, fill the model, then restart npm run dev.
# Providers: ollama | deepseek | qwen | lmstudio | vllm | compatible
LLM_PROVIDER=ollama
# Leave empty for the built-in sample course. Use an installed/authorized model ID.
LLM_MODEL=
# Cloud providers need a key. Local servers may leave this empty unless auth is enabled.
LLM_API_KEY=
# Optional for presets; required for compatible. Do NOT append /chat/completions.
# deepseek: https://api.deepseek.com
# qwen: https://dashscope.aliyuncs.com/compatible-mode/v1 (Beijing)
# ollama: http://127.0.0.1:11434
# lmstudio: http://127.0.0.1:1234/v1
# vllm: http://127.0.0.1:8000/v1
LLM_BASE_URL=
# auto enables JSON mode for Ollama/DeepSeek/Qwen; compatible servers use prompt-only JSON.
# Use on to explicitly enable JSON object mode, off when the model doesn't support it.
LLM_JSON_MODE=auto
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000
PORT=3000
