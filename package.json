{
  "name": "learnflow",
  "version": "1.0.0",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "description": "知行 · 自助 AI 学习与个人知识库",
  "scripts": {
    "desktop": "node desktop/start.cjs",
    "desktop:dev": "node desktop/start.cjs --dev-profile --settings",
    "desktop:pack": "electron-builder --win --dir",
    "desktop:build": "electron-builder --win nsis --x64",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test"
  },
  "engines": { "node": ">=22.16" },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.learnflow.desktop",
    "productName": "Learnflow",
    "directories": { "output": "release" },
    "files": ["desktop/**", "public/**", "server.mjs", "llm.mjs", "package.json"],
    "asar": true,
    "electronFuses": { "runAsNode": false },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "知行 Learnflow",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Learnflow-Setup-${version}.${ext}"
    }
  }
}
