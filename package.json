{
  "name": "learnflow",
  "version": "1.3.9-2",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "description": "知行 · 自助 AI 学习与个人知识库",
  "scripts": {
    "desktop": "node desktop/start.cjs",
    "desktop:dev": "node desktop/start.cjs --dev-profile --settings",
    "desktop:pack": "electron-builder --win --dir",
    "desktop:build": "electron-builder --win nsis --x64",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "27.4.0"
  },
  "build": {
    "appId": "cn.learnflow.desktop",
    "productName": "Learnflow",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "public/**",
      "src/**",
      "server.mjs",
      "test-support/audio.mjs",
      "test-support/materials.mjs",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "知行 Learnflow",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Learnflow-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "mammoth": "1.13.0",
    "marked": "18.0.14",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.5.438"
  }
}
